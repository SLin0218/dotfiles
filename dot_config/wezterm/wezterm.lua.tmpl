   status_mode_bg_table = scheme.ansi[4],
   status_mode_fg = scheme.ansi[1],
}

local ICON_WSL = nerdfonts.linux_nixos or "󱄅"
local ICON_WIN = nerdfonts.custom_windows or ""
local ICON_GIT = nerdfonts.dev_git or ""
local windows_color = "#0078D6"
local git_color = "#F1502F"
local nixos_color = { "#5277C3", "#7EBAE4" }
local SPLIT_ICONS = { "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "¹⁰" }

-- 提取前台进程文件名（去除路径和 .exe）
local function get_process_name(pane)
   local proc = pane.foreground_process_name
   if not proc or #proc == 0 then
      return ""
   end
   return proc:gsub("(.*[/\\])(.*)", "%2"):gsub("%.exe$", "")
end

-- 获取当前工作目录名（家目录显示 ~，其他目录显示末级目录名）
local function get_current_dir(pane)
   local cwd_uri = pane.current_working_dir
   if not cwd_uri or not cwd_uri.file_path then
      return ""
   end
   local cwd = cwd_uri.file_path
   local home = wezterm.home_dir or ""
   local norm_cwd = cwd:gsub("[/\\]+$", "")
   local norm_home = home:gsub("[/\\]+$", "")
   if home ~= "" and norm_cwd == norm_home then
      return "~"
   end
   local dir = norm_cwd:gsub(".*[/\\]", "")
   return dir ~= "" and dir or "/"
end

-- 动态格式化标签标题
wezterm.on("format-tab-title", function(tab, tabs, panes, config, hover, max_width)
   local pane = tab.active_pane
   local title_text = pane.title or ""
   -- 直接使用 tab.panes 避免每次触发 Mux IPC 查询
   local panes_size = (tab.panes and #tab.panes) or 1
   local split_icon = panes_size > 1 and (SPLIT_ICONS[panes_size - 1] or "") or ""

   local icon = tab.is_active and nerdfonts.md_checkbox_blank_circle or nerdfonts.md_checkbox_blank_circle_outline
   local icon_color = tab.is_active and palette.tab_icon_active or palette.tab_icon_inactive

   if is_windows then
      local proc_and_title = (pane.foreground_process_name or "") .. (pane.title or "")
      local is_wsl = string.match(proc_and_title, "wsl") ~= nil
      local is_bash = string.match(proc_and_title, "bash") ~= nil

      icon = is_wsl and ICON_WSL or (is_bash and ICON_GIT or ICON_WIN)
      icon_color = is_wsl and (tab.is_active and nixos_color[1] or nixos_color[2]) or (is_bash and git_color or windows_color)

      if tab.tab_title and #tab.tab_title > 0 then
         title_text = tab.tab_title
      else
         title_text = is_wsl and "WSL" or (is_bash and "BASH" or "PWSH")
      end
   else
      if tab.tab_title and #tab.tab_title > 0 then
         title_text = tab.tab_title
      else
         local proc = get_process_name(pane)
         local is_shell = (proc == "zsh" or proc == "bash" or proc == "fish" or proc == "sh")
         if is_shell then
            local dir = get_current_dir(pane)
            title_text = dir ~= "" and dir or proc
         elseif proc == "ssh" then
            title_text = (pane.title and #pane.title > 0 and not is_shell) and pane.title or "ssh"
         else
            title_text = proc ~= "" and proc or pane.title
         end
      end
   end

   local prefix = split_icon ~= "" and (split_icon .. " ") or ""
   local non_title_width = wezterm.column_width(icon) + wezterm.column_width(prefix) + 4
   local effective_limit = math.min(config.tab_max_width or 32, max_width)
   local max_title_width = effective_limit - non_title_width

   if max_title_width > 0 and wezterm.column_width(title_text) > max_title_width then
      title_text = wezterm.truncate_right(title_text, max_title_width - 1) .. "…"
   end

   local final_title = string.format("%s%s", prefix, title_text)
   local is_act = tab.is_active
   local bg = is_act and palette.tab_active_bg or palette.tab_inactive_bg
   local fg = is_act and palette.tab_active_fg or palette.tab_inactive_fg

   return {
      { Background = { Color = bg } },
      { Attribute = { Intensity = is_act and "Bold" or "Normal" } },
      { Foreground = { Color = icon_color } },
      { Text = " " .. icon .. " " },
      { Foreground = { Color = fg } },
      { Text = final_title .. " " },
      { Background = { Color = palette.tab_bar_bg } },
      { Foreground = { Color = bg } },
      { Text = "▊" },
   }
end)

local mode_mapping = {
   ["copy_mode"] = " Copy ",
   ["resize_pane"] = "Resize",
   ["search_mode"] = "Search",
   ["move_tab"] = " Move ",
}

wezterm.on("update-status", function(window, _)
   local name = window:active_key_table()
   local mode = name and (mode_mapping[name] or name) or "Normal"
   local mode_bg = name and palette.status_mode_bg_table or palette.status_mode_bg_normal
   mode = string.format("%s %s", nerdfonts.dev_vim or "", mode)

   local active_workspace = window:active_workspace()

   window:set_right_status(wezterm.format({
      { Foreground = { Color = palette.tab_active_bg } },
      { Background = { Color = palette.tab_bar_bg } },
      { Text = "" },

      { Background = { Color = palette.tab_active_bg } },
      { Foreground = { Color = palette.tab_active_fg } },
      { Text = "  " .. active_workspace .. " " },

      { Background = { Color = palette.tab_active_bg } },
      { Foreground = { Color = mode_bg } },
      { Text = "" },

      { Background = { Color = mode_bg } },
      { Foreground = { Color = palette.status_mode_fg } },
      { Text = " " .. mode .. " " },
   }))
end)

-- ==========================================
-- 3. 快捷键配置 (快速新建与分屏)
-- ==========================================
local active_pane_info = function(tab)
   for _, item in ipairs(tab:panes_with_info()) do
      if item.is_active then
         return item
      end
   end
end

local activate_pane_direction_keep_zoom_state = function(window, pane, direction)
   local tab = pane:tab()
   local info = active_pane_info(tab)
   local is_zoomed = info and info.is_zoomed or false
   window:perform_action(act.ActivatePaneDirection(direction), pane)
   if is_zoomed then
      window:perform_action(act.TogglePaneZoomState, window:active_pane())
   end
end

local function activate_pane(direction)
   return wezterm.action_callback(function(window, pane)
      activate_pane_direction_keep_zoom_state(window, pane, direction)
   end)
end

-- 统一分屏逻辑（Windows 弹出环境选择器；非 Windows 直接沿用当前环境）
local split_pane = function(direction)
   local split_action = direction == "Horizontal" and act.SplitHorizontal or act.SplitVertical
   if not is_windows then
      return split_action({ domain = "CurrentPaneDomain" })
   end

   return wezterm.action_callback(function(window, pane)
      local choices = {
         { id = "split-current", label = "Current Directory / Domain" },
         { id = "split-wsl", label = "WSL: NixOS (~)" },
         { id = "split-pwsh", label = "PWSH: Local (~)" },
      }
      window:perform_action(
         act.InputSelector({
            title = "Choose Domain (" .. direction .. " Split)",
            choices = choices,
            action = wezterm.action_callback(function(inner_window, inner_pane, id, label)
               if not id and not label then
                  wezterm.log_info("cancelled")
                  return
               end
               if id == "split-current" then
                  inner_window:perform_action(split_action({ domain = "CurrentPaneDomain" }), inner_pane)
               elseif id == "split-wsl" then
                  inner_window:perform_action(
                     split_action({
                        label = "WSL",
                        args = { "wsl.exe", "~" },
                        domain = { DomainName = "unix" },
                     }),
                     inner_pane
                  )
               elseif id == "split-pwsh" then
                  inner_window:perform_action(
                     split_action({
                        label = "PWSH",
                        cwd = "~",
                        domain = { DomainName = "unix" },
                     }),
                     inner_pane
                  )
               end
            end),
         }),
         pane
      )
   end)
end

