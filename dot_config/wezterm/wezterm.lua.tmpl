-- 定义图标与颜色常量
local ICON_WSL = nerdfonts.linux_nixos or "󱄅"
local ICON_WIN = nerdfonts.custom_windows or ""
local ICON_GIT = nerdfonts.dev_git or ""
local windows_color = "#0078D6"
local git_color = "#F1502F"
local nixos_color = { "#5277C3", "#7EBAE4" }
local SPLIT_ICONS = { "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹", "¹⁰" }

-- 动态判断并格式化标签标题
wezterm.on("format-tab-title", function(tab, tabs, panes, config, hover, max_width)
	local pane = tab.active_pane
	local icon = ""
	local icon_color = ""
	local title_text = pane.title
	local split_icon = ""
	local tab_index = tab.tab_index

	-- 获取当前 tab 真实的 pane 数量 (事件第3参数 panes 为全局激活 Tab 的 pane 列表)
	local mux_tab = wezterm.mux.get_tab(tab.tab_id)
	local panes_size = mux_tab and #mux_tab:panes() or 1

	if panes_size > 1 then
		split_icon = SPLIT_ICONS[panes_size - 1] or ""
	end

	local is_wsl_process = false
	local is_bash_process = false
	if is_windows and pane.foreground_process_name then
		is_wsl_process = string.match(pane.foreground_process_name .. pane.title, "wsl") ~= nil
		is_bash_process = string.match(pane.foreground_process_name .. pane.title, "bash") ~= nil
	end

	-- 设置默认图标与状态颜色
	if tab.is_active then
		icon = nerdfonts.md_checkbox_blank_circle
		icon_color = (colors.brights and colors.brights[3]) or "#9ece6a"
	else
		icon = nerdfonts.md_checkbox_blank_circle_outline
		icon_color = (colors.brights and colors.brights[1]) or "#414868"
	end

	if is_windows then
		if is_wsl_process then
			icon_color = tab.is_active and nixos_color[1] or nixos_color[2]
		elseif is_bash_process then
			icon_color = git_color
		else
			icon_color = windows_color
		end
	end

	-- 处理标题与专属图标
	if tab.tab_title and #tab.tab_title > 0 then
		if is_windows then
			icon = is_wsl_process and ICON_WSL or ICON_WIN
		end
		title_text = tab.tab_title
	else
		if is_windows then
			if is_wsl_process then
				icon = ICON_WSL
				title_text = "WSL"
			elseif is_bash_process then
				icon = ICON_GIT
				title_text = "BASH"
			else
				icon = ICON_WIN
				title_text = "PWSH"
			end
		end
	end

	-- 构成前缀字符串 (如 "² 1-" 或 "1-")
	local prefix = (split_icon ~= "" and split_icon or "") .. " " .. (tab_index + 1) .. "-"
	local non_title_width = wezterm.column_width(icon) + wezterm.column_width(prefix) + 2
	local max_title_width = config.tab_max_width - non_title_width

	if max_title_width > 0 and wezterm.column_width(title_text) > max_title_width then
		if max_title_width > 1 then
			title_text = wezterm.truncate_right(title_text, max_title_width - 1) .. "…"
		else
			title_text = wezterm.truncate_right(title_text, max_title_width)
		end
	end

	-- 拼接最终显示的标签文本格式 (末尾有 1 个空格)
	local final_title = string.format("%s%s ", prefix, title_text)
	local active_fg = (colors.tab_bar and colors.tab_bar.active_tab and colors.tab_bar.active_tab.fg_color) or "#c0caf5"
	local active_bg = (colors.tab_bar and colors.tab_bar.active_tab and colors.tab_bar.active_tab.bg_color) or "#cba6f7"
	local inactive_fg = (colors.tab_bar and colors.tab_bar.inactive_tab and colors.tab_bar.inactive_tab.fg_color)
		or "#565f89"
	local tab_bg = (colors.tab_bar and colors.tab_bar.background) or "#16161e"
	local ansi_1 = (colors.ansi and colors.ansi[1]) or "#15161e"

	if tab.is_active then
		return {
			{ Foreground = { Color = active_bg } },
			{ Background = { Color = tab_bg } },
			{ Text = "" },

			{ Background = { Color = active_bg } },
			{ Attribute = { Intensity = "Bold" } },
			{ Foreground = { Color = icon_color } },
			{ Text = icon },

			{ Foreground = { Color = active_fg } },
			{ Text = final_title },

			{ Foreground = { Color = active_bg } },
			{ Background = { Color = tab_bg } },
			{ Text = "" },

			{ Background = { Color = tab_bg } },
			{ Text = " " },
		}
	end

	return {
		{ Foreground = { Color = ansi_1 } },
		{ Background = { Color = tab_bg } },
		{ Text = "" },

		{ Foreground = { Color = icon_color } },
		{ Background = { Color = ansi_1 } },
		{ Text = icon },

		{ Foreground = { Color = inactive_fg } },
		{ Text = final_title },

		{ Foreground = { Color = ansi_1 } },
		{ Background = { Color = tab_bg } },
		{ Text = "" },

		{ Foreground = { Color = inactive_fg } },
		{ Background = { Color = tab_bg } },
		{ Text = " " },
	}
end)

local mode_mapping = {
	["copy_mode"] = " Copy ",
	["resize_pane"] = "Resize",
	["search_mode"] = "Search",
	["move_tab"] = " Move ",
}

wezterm.on("update-status", function(window, _)
	local name = window:active_key_table()
	local mode = ""
	local bg_index = 5
	if name then
		mode = mode_mapping[name] or name
		if name == "copy_mode" then
			bg_index = 4
		end
	else
		mode = "Normal"
	end
	mode = string.format("%s %s", nerdfonts.dev_vim or "", mode)

	local ansi_bg = (colors.ansi and colors.ansi[bg_index]) or "#7aa2f7"
	local ansi_fg = (colors.ansi and colors.ansi[1]) or "#15161e"
	local bg_main = colors.background or "#1a1b26"

	window:set_left_status(wezterm.format({
		{ Foreground = { Color = ansi_bg } },
		{ Background = { Color = bg_main } },
		{ Text = "" },

		{ Background = { Color = ansi_bg } },
		{ Foreground = { Color = ansi_fg } },
		{ Text = mode },

		{ Foreground = { Color = ansi_bg } },
		{ Background = { Color = bg_main } },
		{ Text = "" },

		{ Background = { Color = bg_main } },
		{ Text = " " },
	}))

	local mem = string.format(" %s", ram:update(ram.default_opts))
	window:set_right_status(wezterm.format({
		{ Foreground = { Color = (colors.ansi and colors.ansi[5]) or "#bb9af7" } },
		{ Background = { Color = bg_main } },
		{ Text = "" },

		{ Background = { Color = (colors.ansi and colors.ansi[5]) or "#bb9af7" } },
		{ Foreground = { Color = ansi_fg } },
		{ Text = mem },

		{ Foreground = { Color = (colors.ansi and colors.ansi[5]) or "#bb9af7" } },
		{ Background = { Color = bg_main } },
		{ Text = "" },
	}))
end)

-- ==========================================
-- 3. 快捷键配置 (快速新建与分屏)
-- ==========================================
local active_pane_info = function(tab)
	for _, item in ipairs(tab:panes_with_info()) do
		if item.is_active then
			return item
		end
	end
end

local activate_pane_direction_keep_zoom_state = function(window, pane, direction)
	local tab = pane:tab()
	local info = active_pane_info(tab)
	local is_zoomed = info and info.is_zoomed or false
	window:perform_action(act.ActivatePaneDirection(direction), pane)
	if is_zoomed then
		window:perform_action(act.TogglePaneZoomState, pane)
	end
end

