   bg = scheme.background,
   tab_bar_bg = tb.background or scheme.background,
   tab_active_bg = act_tab.bg_color or scheme.brights[5],
   tab_active_fg = act_tab.fg_color or scheme.ansi[1],
   tab_inactive_bg = inact_tab.bg_color or scheme.ansi[1],
   tab_inactive_fg = inact_tab.fg_color or scheme.brights[1],
   tab_icon_active = scheme.brights[3],
   tab_icon_inactive = scheme.brights[8],
