layout {
    default_tab_template {
        // 顶部一体化状态栏（最左侧：整体方块风格的会话名与模式；接着：矩形标签；右侧：Git 分支、时间）
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "#[bg=#CBA6F7,fg=#11111B,bold]  {session}  {mode}  {tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled "false"

                // --- 模式样式 (与 Session 紧密拼接为整体方块，统一 10 字符宽度，切换无跳动) ---
                mode_normal       "#[bg=#A6E3A1,fg=#1E1E2E,bold]  NORMAL  #[bg=default]"
                mode_tmux         "#[bg=#F5C2E7,fg=#1E1E2E,bold]   TMUX   #[bg=default]"
                mode_locked       "#[bg=#FAB387,fg=#1E1E2E,bold]   COPY   #[bg=default]"
                mode_pane         "#[bg=#74C7EC,fg=#1E1E2E,bold]   PANE   #[bg=default]"
                mode_tab          "#[bg=#CBA6F7,fg=#1E1E2E,bold]   TAB    #[bg=default]"
                mode_resize       "#[bg=#FAB387,fg=#1E1E2E,bold]  RESIZE  #[bg=default]"
                mode_scroll       "#[bg=#F9E2AF,fg=#1E1E2E,bold]  SCROLL  #[bg=default]"
                mode_search       "#[bg=#FAB387,fg=#1E1E2E,bold]  SEARCH  #[bg=default]"
                mode_enter_search "#[bg=#F9E2AF,fg=#1E1E2E,bold] ENT-SRCH #[bg=default]"
                mode_rename_tab   "#[bg=#CBA6F7,fg=#1E1E2E,bold]  RN-TAB  #[bg=default]"
                mode_rename_pane  "#[bg=#74C7EC,fg=#1E1E2E,bold] RN-PANE  #[bg=default]"
                mode_session      "#[bg=#94E2D5,fg=#1E1E2E,bold]   SESS   #[bg=default]"
                mode_move         "#[bg=#89DCEB,fg=#1E1E2E,bold]   MOVE   #[bg=default]"

                // --- 矩形标签样式 (独立卡片色块，激活高亮) ---
                tab_normal              "#[bg=#313244,fg=#CDD6F4]  {index} {name}  #[bg=default] "
                tab_normal_fullscreen   "#[bg=#313244,fg=#CDD6F4]  {index} {name} []  #[bg=default] "
                tab_normal_sync         "#[bg=#313244,fg=#CDD6F4]  {index} {name} <>  #[bg=default] "
                tab_active              "#[bg=#89B4FA,fg=#11111B,bold]  {index} {name}  #[bg=default] "
                tab_active_fullscreen   "#[bg=#89B4FA,fg=#11111B,bold]  {index} {name} []  #[bg=default] "
                tab_active_sync         "#[bg=#89B4FA,fg=#11111B,bold]  {index} {name} <>  #[bg=default] "

                // --- Git 分支信息 (跟随当前聚焦窗格的目录) ---
                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#A6E3A1]  {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"
                command_git_branch_cwd         "{focused_pane_cwd}"

                // --- 日期与时间 (北京时区 UTC+8) ---
                datetime          "#[fg=#BAC2DE,bold] {format} "
                datetime_format   "%Y-%m-%d %H:%M"
                datetime_timezone "Asia/Shanghai"
            }
        }

        // 终端工作区占据剩余的所有垂直空间（底部不再留横栏）
        children
    }
{{- if eq .chezmoi.os "windows" }}
    tab name="wsl"
{{- else }}
    tab name="zsh"
{{- end }}
}
