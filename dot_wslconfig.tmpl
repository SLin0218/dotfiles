[wsl2]
# networkingMode = Mirrored
# dnsTunneling = false
# firewall = false

autoProxy = false
networkingMode = Nat
dnsProxy = true
memory = 24GB
swap = 8GB
swapFile = C:\\Users\\USER\\wsl\\wsl-swap.vhdx
systemDistro = C:\\Users\\USER\\wsl\\system_x64.vhd
guiApplications = true

[experimental]
# hostAddressLoopback = true
autoMemoryReclaim = dropcache
