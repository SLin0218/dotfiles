; -*- gitconfig -*-
; vim: ft=gitconfig
[user]
  email = dengsl.dev@gmail.com
  name = DengShilin
  signingkey = 61AD951AF6587826
[credential]
  helper = store
[core]
  pager = delta
  quotepath = false
  editor = "nvim"
{{- if eq .chezmoi.os "windows" }}
  sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe"
  ; 1. 忽略文件系统的更改时间戳检查差异，避免 DLP 改变元数据触发全量哈希对比
  trustctime = false
  ; 2. 开启 Windows 原生文件系统监控驻留（核心！避免遍历目录树触发大量监控钩子）
  fsmonitor = true
[status]
  ; 3. 避免 git 状态检查时扫描未跟踪文件的内容详情
  showUntrackedFiles = normal
{{- end }}

[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
  line-numbers = true
  navigate = true
[add.interactive]
  useBuiltin = false
[merge]
  conflictstyle = diff3
[difftool]
  prompt = false
  trustExitCode = true
[commit]
  gpgsign = true
[log]
  date = format-local:%Y-%m-%d %H:%M:%S
[http]
  postBuffer = 524288000
  proxy = http://127.0.0.1:7890
[pull]
  rebase = false
{{- if eq .chezmoi.os "windows" }}
[gpg]
  program = "{{ .chezmoi.homeDir }}/scoop/apps/gnupg/current/bin/gpg.exe"
{{- end }}
[https]
  proxy = http://127.0.0.1:7890