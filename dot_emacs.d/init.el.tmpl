;;; init ---  -*- lexical-binding: t; -*-
;;; Commentary:
;;; windows 下初始化配置

;;; code:
(setq nix-librime-path "")
(setq nix-rime-share-data-path "")
(setq nix-jbrsdk-path "")
(setq nix-openjdk21-path "")

;; ==============================================================================
;; Windows Emacs 中文编码配置
;; ==============================================================================
(set-language-environment "UTF-8")
(set-default-coding-systems 'utf-8)
(set-terminal-coding-system 'utf-8)
(set-keyboard-coding-system 'utf-8)
(setq file-name-coding-system 'utf-8)

;; 1. 剪贴板：使用 Windows 原生 UTF-16LE 避免粘贴乱码
(set-selection-coding-system 'utf-16le-dos)
(set-clipboard-coding-system 'utf-16le-dos)

;; 2. 文件读取：优先 UTF-8，兼容 GBK
(prefer-coding-system 'gb18030)
(prefer-coding-system 'utf-8)

;; 3. 子进程输出兼容（如 make / cmd）
(when (eq system-type 'windows-nt)
  (setq default-process-coding-system '(gbk-dos . gbk-dos)))

(with-eval-after-load 'apheleia
  ;; 覆盖默认的 apheleia-npx，直接使用全局 prettier
  (setf (alist-get 'prettier apheleia-formatters)
        '("prettier" "--stdin-filepath" filepath))
  (setf (alist-get 'prettier-yaml apheleia-formatters)
        '("prettier" "--stdin-filepath" filepath "--parser" "yaml"))
  (setf (alist-get 'prettier-json apheleia-formatters)
        '("prettier" "--stdin-filepath" filepath "--parser" "json"))
  (setf (alist-get 'prettier-css apheleia-formatters)
        '("prettier" "--stdin-filepath" filepath "--parser" "css"))
  (setf (alist-get 'prettier-typescript apheleia-formatters)
        '("prettier" "--stdin-filepath" filepath "--parser" "typescript")))

(add-to-list 'load-path "{{ .chezmoi.homeDir }}/.config/slin-emacs")
(require 'slin-emacs)

(provide 'init)
;;; init.el ends here
